# Postgres connection string (Neon / Supabase / RDS / local docker-compose all work)
DATABASE_URL=postgresql://fnv:fnv@localhost:5432/fnv
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_FACTCHECK_API_KEY=
TAVILY_API_KEY=
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=10
# Long random string; enables /#!/admin and /api/admin/*. Leave empty to disable.
ADMIN_KEY=
# Proxies in front of the app that append to X-Forwarded-For (rate limiting uses the entry they add)
TRUSTED_PROXY_HOPS=1
MAX_CONCURRENT_CHECKS=6
